{
  "name": "@lolkda/dsh-retry",
  "version": "0.2.2",
  "description": "DSH plugin for global-default and per-provider retry-policy overrides.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lolkda/dsh-retry.git"
  },
  "type": "module",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "src/host.js",
    "src/policy.js",
    "src/global-sync.js",
    "src/ui-style.js",
    "src/vendor/PROVENANCE.md",
    "src/vendor/LICENSE",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "build": "node scripts/build.mjs",
    "check": "node --check index.js && node --check client.js",
    "verify-notes": "node scripts/verify-notes.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "jsdom": "30.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
