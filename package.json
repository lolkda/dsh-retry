{
  "name": "@local/dsh-retry-settings",
  "version": "0.2.0",
  "description": "Configure one global retry policy through native-style DSH Settings",
  "private": true,
  "type": "module",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "src/host.js",
    "src/policy.js",
    "src/global-sync.js",
    "src/ui-style.js",
    "src/vendor/PROVENANCE.md",
    "src/vendor/LICENSE",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "build": "node scripts/build.mjs",
    "check": "node --check index.js && node --check client.js"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "jsdom": "30.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4"
  }
}
